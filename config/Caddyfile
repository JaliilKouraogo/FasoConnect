{
  log default {
    exclude http.log.error
  }
}
{$DOMAIN} {
  tls internal
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Cache-Control "no-store"
    -Server
  }
  @forbidden path /_matrix/federation/* /_matrix/key/* /_synapse/admin/* /_matrix/media/*/download/* /_matrix/media/*/thumbnail/* /auth/admin/* /auth/realms/master/*
  route {
    respond @forbidden 403
  handle /service/* {
    reverse_proxy service-client:8080
  }
  handle /admin/* {
    reverse_proxy admin:3000
  }
  handle /assistant/api/* {
    reverse_proxy admin:3000
  }
  handle /activate {
    reverse_proxy admin:3000
  }
  handle /room-successors {
    reverse_proxy admin:3000
  }
  handle /directory {
    reverse_proxy admin:3000
  }
  handle /auth/* {
    reverse_proxy identity:8080
  }
  handle /_matrix/* {
    reverse_proxy synapse:8008
  }
  handle /_synapse/client/* {
    reverse_proxy synapse:8008
  }
  handle {
    redir /service/ 302
  }
  }
}


https://identity.localhost {
  @admin path /auth/admin/* /auth/realms/master/*
  respond @admin 403
  tls internal
  reverse_proxy identity:8080
}

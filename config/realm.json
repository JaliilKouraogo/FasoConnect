{
  "realm": "fasoconnect",
  "displayName": "FasoConnect",
  "loginTheme": "fasoconnect",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "sslRequired": "external",
  "browserFlow": "faso-browser",
  "roles": {
    "realm": [
      {
        "name": "agent"
      },
      {
        "name": "responsable"
      },
      {
        "name": "administrateur"
      }
    ]
  },
  "clients": [
    {
      "clientId": "synapse",
      "secret": "${OIDC_SECRET}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://${DOMAIN}/_synapse/client/oidc/callback"
      ],
      "webOrigins": []
    },
    {
      "clientId": "faso-admin",
      "secret": "${ADMIN_OIDC_SECRET}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://${DOMAIN}/admin/callback"
      ],
      "defaultClientScopes": [
        "profile",
        "roles"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "faso-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "faso-admin-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "faso-provisioner",
      "secret": "${PROVISIONER_SECRET}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "authenticationFlows": [
    {
      "alias": "faso-browser",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "flowAlias": "faso-forms",
          "requirement": "REQUIRED",
          "priority": 10
        }
      ]
    },
    {
      "alias": "faso-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr"
}
